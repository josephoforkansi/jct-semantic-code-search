"""Command-line interface for JCT semantic code search."""

import argparse
import contextlib
import sys
from pathlib import Path
from typing import Any

from colorama import Fore, init

from jct.demo import index_folder, index_zip
from jct.json_output import write_json_response
from jct.reformulation import reformulate_query
from jct.search import search, search_with_reformulation
from jct.terminal import (
    display_original_query,
    display_reformulated_queries,
)

init(autoreset=True)


def run_fallback(query: str) -> int:
    """Run Llama fallback and clearly label generated output."""
    try:
        from jct.llm_runtime import generate_fallback

        answer = generate_fallback(query)

        print(Fore.YELLOW + "AI-GENERATED, UNVERIFIED")
        print(
            Fore.YELLOW
            + "This response was generated by AI and was "
            "not retrieved from your project or ZIP archive."
        )
        print(Fore.WHITE + answer)

        return 0

    except Exception as exc:
        print(Fore.RED + f"JCT Llama fallback failed: {exc}")
        return 1


def build_parser() -> argparse.ArgumentParser:
    """Build the JCT command-line argument parser."""
    parser = argparse.ArgumentParser(
        prog="jct",
        description="Search Python code by meaning and behavioral intent.",
    )

    subparsers = parser.add_subparsers(dest="command")

    setup_parser = subparsers.add_parser(
        "setup",
        help="Install the JCT-managed Ollama runtime and Llama model.",
    )
    setup_parser.set_defaults(handler=run_setup)

    search_parser = subparsers.add_parser(
        "search",
        help="Search a Python project or ZIP archive.",
    )

    search_parser.add_argument(
        "query",
        help="Describe the code you want to find.",
    )

    search_parser.add_argument(
        "--path",
        default=".",
        help="Project directory or ZIP archive (default: current directory).",
    )

    search_parser.add_argument(
        "--top-k",
        type=int,
        default=5,
        help="Maximum number of results (default: 5).",
    )

    search_parser.add_argument(
        "--min-score",
        type=float,
        default=0.5,
        help="Minimum relevance score between 0 and 1 (default: 0.5).",
    )

    search_parser.add_argument(
        "--no-query-expansion",
        action="store_true",
        help="Disable query expansion.",
    )

    search_parser.add_argument(
        "--no-typo-correction",
        action="store_true",
        help="Disable typo correction.",
    )

    search_parser.add_argument(
        "--no-query-reformulation",
        action="store_true",
        help="Use the original query without interactive reformulation.",
    )

    search_parser.add_argument(
        "--no-cache",
        action="store_true",
        help="Rebuild the index instead of using a saved cache.",
    )

    search_parser.add_argument(
        "--no-llm",
        action="store_true",
        help="Disable the Llama fallback when no results are found.",
    )

    search_parser.add_argument(
        "--json",
        action="store_true",
        help="Output search results as JSON.",
    )

    return parser


def run_setup() -> int:
    """Install the JCT-managed Ollama runtime and configured model."""
    try:
        from jct.llm_runtime import setup_model

        setup_model()
        return 0

    except Exception as exc:
        print(Fore.RED + f"JCT setup failed: {exc}")
        return 1


def _choose_search_query(
    original_query: str,
) -> tuple[str, str]:
    """
    Let the user choose the original query, a suggestion,
    or automatic reformulation with result fusion.

    Returns:
        The selected query and the search strategy.
        Strategies are "single" and "automatic".
    """
    alternatives = reformulate_query(original_query)

    display_original_query(original_query)
    display_reformulated_queries(alternatives)

    print("\nChoose how you want to search:")
    print("[0] Use my original query")

    for index, suggestion in enumerate(alternatives, start=1):
        print(f"[{index}] {suggestion}")

    print("[A] Automatically combine results from all suggestions")

    if not alternatives:
        print(
            Fore.YELLOW
            + "No alternative queries were generated. "
            "You can still use your original query."
        )

    while True:
        last_option = len(alternatives)

        if last_option:
            prompt = (
                f"\nYour choice (0-{last_option} or A): "
            )
        else:
            prompt = "\nYour choice (0 or A): "

        try:
            choice = input(prompt).strip().lower()
        except (EOFError, KeyboardInterrupt):
            print("\nSearch cancelled.")
            raise

        if choice == "0":
            return original_query, "single"

        if choice == "a":
            return original_query, "automatic"

        if choice.isdigit():
            number = int(choice)

            if 1 <= number <= len(alternatives):
                return alternatives[number - 1], "single"

        if last_option:
            print(
                f"Invalid choice. Enter 0, a number from 1 "
                f"to {last_option}, or A."
            )
        else:
            print("Invalid choice. Enter 0 or A.")


def _print_results(results: list[dict[str, Any]]) -> None:
    """Print ranked code-search results."""
    print(Fore.GREEN + f"\nTop {len(results)} results:\n")

    for rank, result in enumerate(results, start=1):
        score = result.get("score", 0.0)
        file_name = result.get("file", "<unknown>")
        start_line = result.get("start_line", "?")
        result_type = str(result.get("type", "code")).capitalize()
        name = result.get("name", "<unnamed>")

        print(
            Fore.CYAN
            + f"{rank}. Score: {score:.3f} | "
            + f"{file_name}:{start_line} | "
            + f"{result_type} {name}"
        )

        code = result.get("code", "")
        snippet = code[:500]

        if len(code) > 500:
            snippet += "\n..."

        if snippet:
            print(Fore.WHITE + snippet)

        docstring = result.get("docstring", "")

        if docstring:
            print(Fore.MAGENTA + f"Docstring: {docstring[:200]}")

        print("-" * 60)


def _emit_json(
    query: str,
    results: list[dict[str, Any]],
) -> None:
    """Write a JSON response to standard output."""
    write_json_response(query, results)


def run_search(args: argparse.Namespace) -> int:
    """Index the requested source, search it, and optionally invoke Llama."""
    top_k = getattr(args, "top_k", 5)
    min_score = getattr(args, "min_score", 0.5)
    no_cache = getattr(args, "no_cache", False)
    no_llm = getattr(args, "no_llm", False)
    no_query_expansion = getattr(args, "no_query_expansion", False)
    no_typo_correction = getattr(args, "no_typo_correction", False)
    json_mode = getattr(args, "json", False)

    # Preserve compatibility with older callers and test namespaces.
    no_query_reformulation = getattr(
        args,
        "no_query_reformulation",
        True,
    )

    def report_error(message: str) -> None:
        """Send diagnostics to stderr in JSON mode."""
        stream = sys.stderr if json_mode else sys.stdout
        print(message, file=stream)

    if top_k <= 0:
        report_error("Error: --top-k must be greater than zero.")
        return 2

    if not 0.0 <= min_score <= 1.0:
        report_error("Error: --min-score must be between 0 and 1.")
        return 2

    source_path = Path(getattr(args, "path", ".")).expanduser()

    if not source_path.exists():
        report_error(
            f"Error: source path does not exist: {source_path}"
        )
        return 2

    if source_path.is_file() and source_path.suffix.lower() == ".zip":
        index_function = index_zip
    elif source_path.is_dir():
        index_function = index_folder
    else:
        report_error(
            "Error: --path must be a directory or a ZIP archive."
        )
        return 2

    try:
        if json_mode:
            # Keep indexing progress out of JSON standard output.
            with contextlib.redirect_stdout(sys.stderr):
                chunks, embeddings = index_function(
                    source_path,
                    use_cache=not no_cache,
                )
        else:
            chunks, embeddings = index_function(
                source_path,
                use_cache=not no_cache,
            )

    except Exception as exc:
        report_error(f"Indexing failed: {exc}")

        if json_mode:
            _emit_json(args.query, [])

        return 1

    # Keep the original query unless the interactive workflow changes it.
    selected_query = args.query
    search_strategy = "single"

    if not json_mode:
        print(Fore.CYAN + f"\nSource: {source_path.resolve()}")

        if no_query_reformulation:
            print(Fore.CYAN + f"Query: {args.query}")
        else:
            try:
                selected_query, search_strategy = _choose_search_query(
                    args.query
                )
            except (EOFError, KeyboardInterrupt):
                return 130

            print(Fore.CYAN + f"\nSelected query: {selected_query}")

            if search_strategy == "automatic":
                print(
                    Fore.CYAN
                    + "Search strategy: automatic reformulation with RRF"
                )
            else:
                print(
                    Fore.CYAN
                    + "Search strategy: single-query semantic search"
                )

    if not chunks:
        if json_mode:
            _emit_json(args.query, [])
            return 1 if not no_llm else 0

        print(Fore.YELLOW + "No searchable Python code was found.")

        if no_llm:
            return 1

        return run_fallback(args.query)

    try:
        # Search functions may print diagnostics. In JSON mode,
        # redirect those messages away from standard output.
        output_context = (
            contextlib.redirect_stdout(sys.stderr)
            if json_mode
            else contextlib.nullcontext()
        )

        with output_context:
            if search_strategy == "automatic":
                results = search_with_reformulation(
                    selected_query,
                    chunks,
                    embeddings,
                    top_k=top_k,
                    min_score=min_score,
                    use_query_expansion=not no_query_expansion,
                    use_typo_correction=not no_typo_correction,
                )
            else:
                results = search(
                    selected_query,
                    chunks,
                    embeddings,
                    top_k=top_k,
                    min_score=min_score,
                    use_query_expansion=not no_query_expansion,
                    use_typo_correction=not no_typo_correction,
                )

    except Exception as exc:
        report_error(f"Search failed: {exc}")

        if json_mode:
            _emit_json(args.query, [])

        return 1

    if json_mode:
        _emit_json(args.query, results)
        return 0

    if not results:
        print(Fore.YELLOW + "No results met the relevance threshold.")

        if no_llm:
            return 0

        print(Fore.YELLOW + "\nTrying the Llama fallback...")
        return run_fallback(selected_query)

    _print_results(results)
    return 0


def main() -> int:
    """Run the JCT command-line interface."""
    parser = build_parser()
    args = parser.parse_args()

    if args.command == "search":
        return run_search(args)

    if args.command == "setup":
        return run_setup()

    parser.print_help()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
